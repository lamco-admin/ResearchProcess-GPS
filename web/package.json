{
  "name": "researchprocess-gps-web",
  "version": "0.1.0",
  "description": "Web interface for ResearchProcess-GPS using WASM",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "wasm:build": "wasm-pack build --target web --out-dir web/pkg ../crates/rp-wasm",
    "wasm:dev": "wasm-pack build --dev --target web --out-dir web/pkg ../crates/rp-wasm"
  },
  "dependencies": {
    "svelte": "^4.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "vite": "^5.0.0",
    "vite-plugin-wasm": "^3.3.0"
  }
}
